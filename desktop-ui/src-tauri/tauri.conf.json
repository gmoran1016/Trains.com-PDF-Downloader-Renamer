{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trains.com Archive",
  "version": "2.0.2",
  "identifier": "com.gmoran.trainsdownloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trains.com Archive",
        "width": 1120,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "backgroundColor": "#f5f7f9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "updater:default",
            "process:allow-restart",
            {
              "identifier": "opener:allow-open-url",
              "allow": [
                {
                  "url": "https://github.com/gmoran1016/Trains.com-PDF-Downloader-Renamer/releases/latest/download/TrainsDownloader-windows.exe"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFRkNFRUYxQjg5NjJDNEMKUldSTUxKYTQ4ZTc4bnJmV0VTR1pSZEJaTzBEK0wyMjU2eHR6eXM1dGJ2OGJqQk9IaFdTOU1ncHAK",
      "endpoints": [
        "https://github.com/gmoran1016/Trains.com-PDF-Downloader-Renamer/releases/latest/download/latest.json"
      ]
    }
  }
}
